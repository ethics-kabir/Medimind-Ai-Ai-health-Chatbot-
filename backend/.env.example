# Optional. Leave blank to use the built-in educational demo responses.
GEMINI_API_KEY=

# Local SQLite is convenient for development. Use PostgreSQL for hosted deployments.
DATABASE_URL=sqlite:///./medimind.db

# Comma-separated frontend origins; update this for your deployed frontend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost
