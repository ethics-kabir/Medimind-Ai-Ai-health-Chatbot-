# Runtime mode: use production on hosted deployments.
APP_ENV=development

# Optional. Leave blank to use built-in educational demo responses.
GEMINI_API_KEY=

# Local SQLite is convenient for development. Use PostgreSQL for hosted deployments.
DATABASE_URL=sqlite:///./medimind.db

# Comma-separated frontend origins. In production, avoid wildcards and localhost values.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Maximum accepted HTTP request size in bytes.
MAX_REQUEST_BYTES=65536

# In production this should usually be false unless you intentionally allow shared unauthenticated history.
ENABLE_UNAUTHENTICATED_HISTORY=true

# Optional admin token to access restricted history endpoints when unauthenticated history is disabled.
MEDIMIND_ADMIN_TOKEN=
